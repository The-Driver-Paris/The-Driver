# Copy this file to `.env` and fill in the value below.
#
# IMPORTANT: it is baked into the static build at COMPILE time, not read at
# runtime. If you change it you must re-run `npm run build` and redeploy —
# redeploying alone does nothing.

# ---------------------------------------------------------------------------
# Cloudflare Worker URL — the site's only backend. It receives BOTH the
# booking modal and the FAQ-page contact form, and sends every email through
# Resend from the verified `thedriver.fr` domain:
#
#   - booking  → chauffeur notification (FR) + customer confirmation (EN)
#   - contact  → chauffeur notification (FR)
#
# The Worker tells the two apart by the `formType` field in the payload.
#
# Deploy the Worker first (see worker/README.md); Wrangler prints the URL when
# it finishes. Paste it here.
#
# Until this is set, both forms render fine but show "Missing form config"
# when submitted.
# ---------------------------------------------------------------------------
PUBLIC_WORKER_URL=https://driver-services-form.your-subdomain.workers.dev
