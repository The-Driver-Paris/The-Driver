# Copy this file to `.env` and fill in the two values below.
#
# IMPORTANT: both are baked into the static build at COMPILE time, not
# read at runtime. If you change any of them you must re-run `npm run build`
# and redeploy — redeploying alone does nothing.

# ---------------------------------------------------------------------------
# 1. Cloudflare Worker URL — receives booking submissions from the static site
#    and sends two emails via Resend (chauffeur notification + customer auto-
#    confirmation). Deploy the Worker first (see worker/README.md); Wrangler
#    prints the URL when it finishes. Paste it here.
#
#    Until this is set, the booking form renders fine but shows
#    "Missing form config" when submitted.
# ---------------------------------------------------------------------------
PUBLIC_WORKER_URL=https://driver-services-form.your-subdomain.workers.dev

# ---------------------------------------------------------------------------
# 2. Web3Forms access key — powers the separate contact form at the bottom of
#    the FAQ / Contact page. This is NOT the same system as the booking form
#    above; it posts straight to web3forms.com and needs its own free account.
#
#    Get a key at https://web3forms.com — enter the address that should
#    receive contact messages, they email you the key. No password needed.
#
#    Until this is set, the contact form shows "Missing form config" on submit.
# ---------------------------------------------------------------------------
PUBLIC_WEB3FORMS_KEY=
