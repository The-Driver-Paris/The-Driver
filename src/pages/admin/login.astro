---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Sign in · The Driver admin</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100dvh; display: grid; place-items: center;
        background: #0f1b2d; color: #e8edf2;
        font: 14px/1.55 "Segoe UI", system-ui, Arial, sans-serif; padding: 24px;
      }
      form {
        width: 100%; max-width: 340px; background: #14202f;
        border: 1px solid #24313f; border-radius: 14px; padding: 26px;
      }
      .wm { font-weight: 700; letter-spacing: .14em; font-size: 13px; text-transform: uppercase; margin-bottom: 18px; }
      .wm b { color: #c88a3b; }
      label { display: block; font-weight: 600; margin: 14px 0 5px; font-size: 13px; }
      input {
        width: 100%; padding: 10px 12px; border: 1px solid #33475a; border-radius: 8px;
        background: #0f1b2d; color: #e8edf2; font: inherit;
      }
      button {
        width: 100%; margin-top: 20px; height: 42px; border: 0; border-radius: 8px;
        background: #c88a3b; color: #fff; font: inherit; font-weight: 700; cursor: pointer;
      }
      button:disabled { opacity: .6; cursor: default; }
      .msg { margin-top: 14px; font-size: 13px; min-height: 18px; }
      .msg.err { color: #ff9a94; }
      a.reset { display: inline-block; margin-top: 14px; color: #9fb0c0; font-size: 13px; }
    </style>
  </head>
  <body>
    <form data-login>
      <div class="wm">THE&nbsp;<b>DRIVER</b> · admin</div>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <button type="submit" data-submit>Sign in</button>
      <p class="msg" data-msg></p>
      <a class="reset" href="#" data-reset>Forgot password?</a>
    </form>

    <script>
      import { getBrowserClient } from '../../lib/supabase';
      const sb = getBrowserClient();
      const form = document.querySelector<HTMLFormElement>('[data-login]')!;
      const msg = document.querySelector<HTMLElement>('[data-msg]')!;
      const btn = document.querySelector<HTMLButtonElement>('[data-submit]')!;

      // already signed in? go straight in.
      sb.auth.getSession().then(({ data }) => { if (data.session) location.href = '/admin'; });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.textContent = ''; msg.className = 'msg';
        btn.disabled = true;
        const fd = new FormData(form);
        const { error } = await sb.auth.signInWithPassword({
          email: String(fd.get('email')).trim(),
          password: String(fd.get('password')),
        });
        btn.disabled = false;
        if (error) { msg.textContent = 'Wrong email or password.'; msg.className = 'msg err'; return; }
        location.href = '/admin';
      });

      document.querySelector('[data-reset]')?.addEventListener('click', async (e) => {
        e.preventDefault();
        const email = (document.querySelector<HTMLInputElement>('#email')!).value.trim();
        if (!email) { msg.textContent = 'Enter your email first, then click again.'; msg.className = 'msg err'; return; }
        const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo: location.origin + '/admin/login' });
        msg.className = 'msg';
        msg.textContent = error ? 'Could not send the reset email.' : 'Check your inbox for a reset link.';
      });
    </script>
  </body>
</html>
