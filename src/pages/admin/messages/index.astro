---
import AdminShell from '../_AdminShell.astro';
// Client-rendered shell — see src/pages/admin/index.astro.
export const prerender = true;
---

<AdminShell title="Messages" titleKey="nav.messages" section="messages">
  <div class="a-page-head">
    <h1 class="a-h1" data-i18n="messages.title">Messages</h1>
    <p class="a-sub" data-i18n="messages.subtitle">Contact-form submissions, also kept here.</p>
  </div>

  <div class="a-filters">
    <select class="a-select" data-filter>
      <option value="" data-i18n="common.allStatuses">All statuses</option>
      <option value="new" data-i18n="status.new">New</option>
      <option value="contacted" data-i18n="status.contacted">Contacted</option>
      <option value="done" data-i18n="status.done">Done</option>
      <option value="cancelled" data-i18n="status.cancelled">Cancelled</option>
    </select>
  </div>

  <div data-list><div class="a-empty" data-i18n="common.loading">Loading…</div></div>

  <script>
    import { getBrowserClient } from '../../../lib/supabase';
    import type { ContactMessageRow, MessageStatus } from '../../../lib/database.types';
    const sb = getBrowserClient();
    const toast = window.adminToast;
    const T = window.adminT;
    const list = document.querySelector<HTMLElement>('[data-list]')!;
    const filter = document.querySelector<HTMLSelectElement>('[data-filter]')!;
    const STATUSES = ['new', 'contacted', 'done', 'cancelled'];
    let cache: ContactMessageRow[] = [];
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });

    function render() {
      const rows = cache.filter((m) => !filter.value || m.status === filter.value);
      if (!rows.length) { list.innerHTML = `<div class="a-card a-empty">${T('common.none')}</div>`; return; }
      list.innerHTML = rows.map((m) => `
        <div class="a-card" style="margin-bottom:10px">
          <div class="a-row" style="align-items:flex-start">
            <div>
              <strong>${esc(m.first_name)}</strong> <span class="a-badge ${m.status}">${T('status.' + m.status)}</span><br>
              <span style="color:#98a2b0;font-size:12px">${fmt(m.created_at)} · ${esc(m.email)} · ${esc(m.language)}</span>
            </div>
            <select class="a-select a-btn-sm" data-status data-id="${m.id}" style="min-width:150px;max-width:160px">
              ${STATUSES.map((s) => `<option value="${s}" ${s === m.status ? 'selected' : ''}>${T('status.' + s)}</option>`).join('')}
            </select>
          </div>
          <p style="white-space:pre-wrap;margin:12px 0 0">${esc(m.message)}</p>
          <a class="a-btn a-btn-sm" style="margin-top:10px" href="mailto:${esc(m.email)}?subject=Re:%20your%20message%20to%20The%20Driver">${T('messages.reply')}</a>
        </div>`).join('');
    }

    async function load() {
      const { data, error } = await sb.from('contact_messages').select('*').order('created_at', { ascending: false }).limit(500);
      if (error) { list.innerHTML = `<div class="a-card a-empty a-error">${T('messages.loadError')}</div>`; return; }
      cache = data ?? []; render();
    }
    list.addEventListener('change', async (e) => {
      const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-status]');
      if (!sel) return;
      const status = sel.value as MessageStatus;
      const { error } = await sb.from('contact_messages').update({ status }).eq('id', sel.dataset.id!);
      if (error) { toast(T('messages.updateError'), 'err'); load(); return; }
      const row = cache.find((m) => m.id === sel.dataset.id); if (row) row.status = status;
      toast(T('toast.updated'), 'ok');
    });
    filter.addEventListener('change', render);
    window.addEventListener('admin:ready', load);
  </script>
</AdminShell>
