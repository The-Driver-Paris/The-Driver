---
import AdminShell from '../_AdminShell.astro';
// Client-rendered shell — see src/pages/admin/index.astro.
export const prerender = true;
---

<AdminShell title="Blog" titleKey="nav.blog" section="blog">
  <div class="a-page-head a-row">
    <div>
      <h1 class="a-h1" data-i18n="blog.title">Blog</h1>
      <p class="a-sub" data-i18n="blog.subtitle">Write, schedule and publish articles.</p>
    </div>
    <a class="a-btn a-btn-primary" href="/admin/blog/new/">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      <span data-i18n="blog.new">New article</span>
    </a>
  </div>

  <div class="a-filters">
    <select class="a-select" data-filter-locale>
      <option value="" data-i18n="common.allLanguages">All languages</option>
      <option value="en">English</option>
      <option value="fr">Français</option>
      <option value="es">Español</option>
      <option value="it">Italiano</option>
    </select>
    <select class="a-select" data-filter-status>
      <option value="" data-i18n="common.allStatuses">All statuses</option>
      <option value="published" data-i18n="status.published">Published</option>
      <option value="scheduled" data-i18n="status.scheduled">Scheduled</option>
      <option value="draft" data-i18n="status.draft">Draft</option>
    </select>
  </div>

  {/* desktop: table — mobile: card list. One data source, two renderers. */}
  <div class="a-tablewrap blist-table">
    <table class="a-table">
      <thead>
        <tr>
          <th data-i18n="blog.colTitle">Title</th>
          <th style="width:70px" data-i18n="blog.colLang">Lang</th>
          <th style="width:120px" data-i18n="blog.colStatus">Status</th>
          <th style="width:130px" data-i18n="blog.colDate">Date</th>
          <th style="width:48px"></th>
        </tr>
      </thead>
      <tbody data-rows-table></tbody>
    </table>
  </div>
  <ul class="blist-cards" data-rows-cards></ul>

  <style>
    .blist-cards { list-style: none; margin: 0; padding: 0; display: none; flex-direction: column; gap: 10px; }
    @media (max-width: 719px) {
      .blist-table { display: none; }
      .blist-cards { display: flex; }
    }
    .blist-card {
      background: var(--a-card); border: 1px solid var(--a-border);
      border-radius: var(--a-radius); padding: 14px 15px; box-shadow: var(--a-shadow);
    }
    .blist-card a.t { font-weight: 700; color: var(--a-text); display: block; line-height: 1.35; }
    .blist-card .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; color: var(--a-muted); font-size: 12.5px; }
    .blist-card .slug { color: #98a2b0; font-size: 12px; margin-top: 3px; word-break: break-all; }
    .blist-card .row2 { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; }
    .blist-card .prev { color: var(--a-accent-ink); font-weight: 600; font-size: 13px; display: inline-flex; align-items: center; gap: 4px; }
    .a-table td .t { font-weight: 600; color: #14324f; }
    .a-table td .slug { color: #98a2b0; font-size: 12px; margin-top: 2px; }
    .a-table td .prev { color: var(--a-accent-ink); }
  </style>

  <script>
    import { getBrowserClient } from '../../../lib/supabase';
    import { formatPostDate } from '../../../lib/blog';
    import type { BlogPostRow } from '../../../lib/database.types';
    const sb = getBrowserClient();
    const T = window.adminT;
    const tableBody = document.querySelector<HTMLElement>('[data-rows-table]')!;
    const cardsBox = document.querySelector<HTMLElement>('[data-rows-cards]')!;
    const fLocale = document.querySelector<HTMLSelectElement>('[data-filter-locale]')!;
    const fStatus = document.querySelector<HTMLSelectElement>('[data-filter-status]')!;

    // Only the columns the list query below actually selects.
    type BlogListRow = Pick<BlogPostRow, 'id' | 'slug' | 'locale' | 'status' | 'title' | 'published_at' | 'updated_at'>;

    const esc = (s: string) => (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const statusLabel = (s: string) => T('status.' + s);
    const dateOf = (p: BlogListRow) => (p.status === 'published' ? formatPostDate(p.published_at, p.locale) : formatPostDate(p.updated_at, p.locale));

    function render(rows: BlogListRow[]) {
      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="5" class="a-empty">${T('blog.empty')}</td></tr>`;
        cardsBox.innerHTML = `<li class="a-empty">${T('blog.empty')}</li>`;
        return;
      }
      tableBody.innerHTML = rows.map((p) => `
        <tr>
          <td>
            <a class="t" href="/admin/blog/${p.id}/">${esc(p.title) || T('blog.untitled')}</a>
            <div class="slug">/${esc(p.slug)}</div>
          </td>
          <td>${p.locale.toUpperCase()}</td>
          <td><span class="a-badge ${p.status}">${statusLabel(p.status)}</span></td>
          <td style="white-space:nowrap">${dateOf(p)}</td>
          <td><a class="prev" href="/blog/${esc(p.slug)}" target="_blank" rel="noopener" title="${T('common.preview')}">↗</a></td>
        </tr>`).join('');
      cardsBox.innerHTML = rows.map((p) => `
        <li class="blist-card">
          <a class="t" href="/admin/blog/${p.id}/">${esc(p.title) || T('blog.untitled')}</a>
          <div class="slug">/${esc(p.slug)}</div>
          <div class="row2">
            <span class="meta">
              <span class="a-badge ${p.status}">${statusLabel(p.status)}</span>
              <span>${p.locale.toUpperCase()}</span>
              <span>· ${dateOf(p)}</span>
            </span>
            <a class="prev" href="/blog/${esc(p.slug)}" target="_blank" rel="noopener">${T('common.preview')} ↗</a>
          </div>
        </li>`).join('');
    }

    async function load() {
      tableBody.innerHTML = `<tr><td colspan="5" class="a-empty">${T('common.loading')}</td></tr>`;
      cardsBox.innerHTML = `<li class="a-empty">${T('common.loading')}</li>`;
      let q = sb.from('blog_posts')
        .select('id,slug,locale,status,title,published_at,updated_at')
        .order('updated_at', { ascending: false })
        .limit(200);
      if (fLocale.value) q = q.eq('locale', fLocale.value as 'en' | 'fr' | 'es' | 'it');
      if (fStatus.value) q = q.eq('status', fStatus.value as 'draft' | 'scheduled' | 'published');
      const { data, error } = await q;
      if (error) {
        tableBody.innerHTML = `<tr><td colspan="5" class="a-empty a-error">${T('blog.loadError')}</td></tr>`;
        cardsBox.innerHTML = `<li class="a-empty a-error">${T('blog.loadError')}</li>`;
        return;
      }
      render(data ?? []);
    }

    fLocale.addEventListener('change', load);
    fStatus.addEventListener('change', load);
    window.addEventListener('admin:ready', load);
  </script>
</AdminShell>
