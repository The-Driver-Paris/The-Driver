---
import AdminShell from './_AdminShell.astro';
// Static shell: all data is fetched client-side with the viewer's own session,
// so there's nothing to render on the server. Prerendering it serves the page
// from the CDN with no serverless cold start on every navigation.
export const prerender = true;
---

<AdminShell title="Overview" titleKey="nav.overview" section="overview">
  <div class="a-page-head">
    <h1 class="a-h1" data-i18n="overview.title">Dashboard</h1>
    <p class="a-sub" data-hello data-i18n="overview.welcome">Welcome back.</p>
  </div>

  <div class="a-stats">
    <a class="a-card a-stat" href="/admin/blog/">
      <span class="k" data-i18n="nav.blog">Blog</span>
      <span class="v" data-stat="blog">—</span>
      <span class="d" data-i18n="overview.blogStat">published articles</span>
    </a>
    <a class="a-card a-stat" href="/admin/bookings/">
      <span class="k" data-i18n="nav.bookings">Bookings</span>
      <span class="v" data-stat="bookings">—</span>
      <span class="d" data-i18n="overview.bookingsStat">new / unhandled</span>
    </a>
    <a class="a-card a-stat" href="/admin/messages/">
      <span class="k" data-i18n="nav.messages">Messages</span>
      <span class="v" data-stat="messages">—</span>
      <span class="d" data-i18n="overview.messagesStat">new / unread</span>
    </a>
  </div>

  <script>
    import { getBrowserClient } from '../../lib/supabase';
    const sb = getBrowserClient();
    const T = window.adminT;

    window.addEventListener('admin:ready', async (e) => {
      const detail = (e as CustomEvent).detail as { isOwner: boolean; sections: string[] };
      const can = (s: string) => detail.isOwner || detail.sections.includes(s);

      const hello = document.querySelector('[data-hello]');
      if (hello) hello.textContent = T(detail.isOwner ? 'overview.welcomeOwner' : 'overview.welcome');

      const set = (k: string, v: number | string) => {
        const el = document.querySelector(`[data-stat="${k}"]`);
        if (el) el.textContent = String(v);
      };

      if (can('blog')) {
        const { count } = await sb.from('blog_posts').select('id', { count: 'exact', head: true }).eq('status', 'published');
        set('blog', count ?? 0);
      } else set('blog', '–');

      if (can('bookings')) {
        const { count } = await sb.from('bookings').select('id', { count: 'exact', head: true }).in('status', ['new', 'contacted']);
        set('bookings', count ?? 0);
      } else set('bookings', '–');

      if (can('messages')) {
        const { count } = await sb.from('contact_messages').select('id', { count: 'exact', head: true }).eq('status', 'new');
        set('messages', count ?? 0);
      } else set('messages', '–');
    });
  </script>
</AdminShell>
