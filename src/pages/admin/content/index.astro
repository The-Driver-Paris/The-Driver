---
import AdminShell from '../_AdminShell.astro';
// Client-rendered shell — see src/pages/admin/index.astro.
export const prerender = true;

const PAGES = [
  { key: 'disneyland', i18n: 'content.page.disneyland' },
  { key: 'parisTransfer', i18n: 'content.page.parisTransfer' },
  { key: 'parisChauffeur', i18n: 'content.page.parisChauffeur' },
];
---

<AdminShell title="Page text" titleKey="nav.content" section="content">
  <div class="a-page-head">
    <h1 class="a-h1" data-i18n="content.title">Edit page text</h1>
    <p class="a-sub" data-i18n="content.subtitle">Change the wording on the landing pages, per language. Leaving a box empty keeps the original text.</p>
  </div>

  <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))">
    {PAGES.map((p) => (
      <a class="a-card" href={`/admin/content/${p.key}/`} style="display:flex;flex-direction:column;gap:6px">
        <strong style="color:#14324f" data-i18n={p.i18n}>{p.key}</strong>
        <span style="color:var(--a-muted)" data-i18n="content.editHint">Edit headings, intros, FAQ…</span>
      </a>
    ))}
  </div>
</AdminShell>
