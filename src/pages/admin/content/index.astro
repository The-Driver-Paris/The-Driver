---
import AdminShell from '../_AdminShell.astro';
export const prerender = false;

const PAGES = [
  { key: 'disneyland', label: 'Disneyland Paris page' },
  { key: 'parisTransfer', label: 'Paris airport transfer page' },
  { key: 'parisChauffeur', label: 'Paris chauffeur hire page' },
];
---

<AdminShell title="Page text" section="content">
  <h1 class="a-h1">Edit page text</h1>
  <p class="a-sub">Change the wording on the landing pages, per language. Leaving a box empty keeps the original text.</p>

  <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
    {PAGES.map((p) => (
      <a class="a-card" href={`/admin/content/${p.key}`} style="text-decoration:none">
        <strong style="color:#14324f">{p.label}</strong>
        <div style="color:#5b6774;margin-top:4px">Edit headings, intros, FAQ…</div>
      </a>
    ))}
  </div>
</AdminShell>
