---
import AdminShell from '../_AdminShell.astro';
import { t, LOCALES } from '../../../i18n';
import { flattenCopy } from '../../../lib/pageContent';
// Client-rendered shell — see src/pages/admin/index.astro. The editable page set
// is fixed, so every route is known at build time and prerenders statically.
export const prerender = true;

export function getStaticPaths() {
  // Must be self-contained — Astro runs getStaticPaths in an isolated scope.
  return ['disneyland', 'parisTransfer', 'parisChauffeur'].map((page) => ({ params: { page } }));
}
const pageKey = Astro.params.page ?? '';

const TITLE_KEY: Record<string, string> = {
  disneyland: 'content.page.disneyland',
  parisTransfer: 'content.page.parisTransfer',
  parisChauffeur: 'content.page.parisChauffeur',
};

// Compiled copy per locale, flattened to editable leaves. The client shows each
// leaf's text as the input placeholder, so an empty box = "use the original".
const compiled: Record<string, { path: string; text: string }[]> = {};
for (const l of LOCALES) {
  compiled[l] = flattenCopy((t(l) as Record<string, unknown>)[pageKey]);
}
---

<AdminShell title="Page text" titleKey={TITLE_KEY[pageKey]} section="content">
  <a href="/admin/content/" class="a-sub" style="display:inline-flex;align-items:center;gap:5px">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <span data-i18n="content.allPages">All pages</span>
  </a>
  <h1 class="a-h1" style="margin-top:10px" data-i18n={TITLE_KEY[pageKey]}>Page text</h1>
  <p class="a-sub" data-i18n="content.rowHint">Each row shows the current wording as faint placeholder text. Type to override it; clear the box to restore the original.</p>

  <div class="seg" style="margin:18px 0">
    {LOCALES.map((l, i) => (
      <button class="seg-btn" data-tab={l} aria-pressed={i === 0 ? 'true' : 'false'}>{l.toUpperCase()}</button>
    ))}
  </div>

  <form data-form>
    <div data-fields class="a-card"><span data-i18n="common.loading">Loading…</span></div>
    <div style="margin-top:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:sticky;bottom:0;background:var(--a-page);padding:10px 0;border-top:1px solid var(--a-border)">
      <button type="submit" class="a-btn a-btn-primary" data-save data-i18n="common.saveChanges">Save changes</button>
      <span data-count class="a-hint"></span>
    </div>
  </form>

  <style>
    .seg { display: inline-flex; background: #eceff3; border-radius: 10px; padding: 3px; gap: 2px; }
    .seg-btn { border: 0; background: none; padding: 7px 16px; border-radius: 8px; font: inherit; font-weight: 600; font-size: 13px; color: var(--a-muted); cursor: pointer; }
    .seg-btn[aria-pressed="true"] { background: var(--a-card); color: var(--a-text); box-shadow: var(--a-shadow); }
    [data-fields] .fld { margin-bottom: 14px; }
    [data-fields] .fld:last-child { margin-bottom: 0; }
    [data-fields] .fld label { display: block; font-size: 12px; font-weight: 600; color: var(--a-muted); margin-bottom: 4px; }
  </style>

  <script is:inline define:vars={{ pageKey, compiled, locales: LOCALES }}>
    window.__contentEditor = { pageKey, compiled, locales };
  </script>

  <script>
    import { getBrowserClient } from '../../../lib/supabase';
    const { pageKey, compiled, locales } = (window as any).__contentEditor as {
      pageKey: string; compiled: Record<string, { path: string; text: string }[]>; locales: string[];
    };
    const sb = getBrowserClient();
    const toast = (window as any).adminToast as (m: string, k?: string) => void;
    const T = (k: string) => (window as any).adminT(k) as string;
    const fields = document.querySelector<HTMLElement>('[data-fields]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    let overrides: Record<string, Record<string, string>> = {};
    let active = locales[0];

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const labelFor = (p: string) => p.replace(/\.(\d+)\./g, ' #$1 ').replace(/\./g, ' › ');

    function renderFields() {
      const leaves = compiled[active] ?? [];
      fields.innerHTML = leaves.map((leaf) => {
        const val = overrides[active]?.[leaf.path] ?? '';
        const multiline = leaf.text.length > 90;
        const input = multiline
          ? `<textarea class="a-textarea" data-path="${esc(leaf.path)}" placeholder="${esc(leaf.text)}" style="min-height:64px">${esc(val)}</textarea>`
          : `<input class="a-input" data-path="${esc(leaf.path)}" placeholder="${esc(leaf.text)}" value="${esc(val)}" />`;
        return `<div class="fld"><label>${esc(labelFor(leaf.path))}</label>${input}</div>`;
      }).join('');
      updateCount();
    }
    function updateCount() {
      const n = Object.values(overrides).reduce((a, m) => a + Object.keys(m).length, 0);
      count.textContent = n ? `${n} ${T('content.overridesSet')}` : T('content.noOverrides');
    }

    fields.addEventListener('input', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLInputElement | HTMLTextAreaElement>('[data-path]');
      if (!el) return;
      overrides[active] ??= {};
      const v = el.value;
      if (v.trim() === '') delete overrides[active][el.dataset.path!];
      else overrides[active][el.dataset.path!] = v;
      updateCount();
    });

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-tab]')) {
      btn.addEventListener('click', () => {
        active = btn.dataset.tab!;
        document.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        renderFields();
      });
    }

    async function load() {
      const { data, error } = await sb.from('page_overrides')
        .select('field_key, locale, value').eq('page_key', pageKey);
      if (error) toast(T('toast.loadError'), 'err');
      overrides = {};
      for (const row of data ?? []) {
        if (row.value && row.value.trim() !== '') {
          overrides[row.locale] ??= {};
          overrides[row.locale][row.field_key] = row.value;
        }
      }
      renderFields();
    }

    document.querySelector('[data-form]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const save = document.querySelector<HTMLButtonElement>('[data-save]')!;
      save.disabled = true;
      try {
        const desired: { page_key: string; field_key: string; locale: string; value: string }[] = [];
        for (const [loc, m] of Object.entries(overrides))
          for (const [path, value] of Object.entries(m))
            desired.push({ page_key: pageKey, field_key: path, locale: loc, value });

        if (desired.length) {
          const { error } = await sb.from('page_overrides')
            .upsert(desired, { onConflict: 'page_key,field_key,locale' });
          if (error) { toast(T('toast.saveError'), 'err'); return; }
        }
        const keep = new Set(desired.map((d) => `${d.locale}::${d.field_key}`));
        const { data: existing } = await sb.from('page_overrides')
          .select('id, field_key, locale').eq('page_key', pageKey);
        const stale = (existing ?? []).filter((r) => !keep.has(`${r.locale}::${r.field_key}`)).map((r) => r.id);
        if (stale.length) {
          const { error } = await sb.from('page_overrides').delete().in('id', stale);
          if (error) { toast(T('toast.saveError'), 'err'); return; }
        }
        toast(T('toast.saved'), 'ok');
      } finally { save.disabled = false; }
    });

    window.addEventListener('admin:ready', load);
  </script>
</AdminShell>
