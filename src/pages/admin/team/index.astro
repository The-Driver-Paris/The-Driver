---
import AdminShell from '../_AdminShell.astro';
import { GRANTABLE_SECTIONS } from '../../../lib/adminSections';
// Client-rendered shell — see src/pages/admin/index.astro.
export const prerender = true;
const SECTION_KEYS = GRANTABLE_SECTIONS.map((s) => s.key);
---

<AdminShell title="Team" titleKey="nav.team" section="team">
  <div class="a-page-head">
    <h1 class="a-h1" data-i18n="team.title">Team</h1>
    <p class="a-sub" data-i18n="team.subtitle">Create logins for staff and choose which sections each one can use. Enforced by the database.</p>
  </div>

  <div class="a-card" style="margin-bottom:20px">
    <strong data-i18n="team.add">Add a staff member</strong>
    <form data-create style="margin-top:12px">
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
          <label class="a-label" for="ne" data-i18n="team.email">Email</label>
          <input class="a-input" id="ne" name="email" type="email" required />
        </div>
        <div style="flex:1;min-width:200px">
          <label class="a-label" for="np" data-i18n="team.tempPassword">Temporary password</label>
          <input class="a-input" id="np" name="password" minlength="8" required />
          <p class="a-hint" data-i18n="team.passwordHint">At least 8 characters. They can change it after signing in.</p>
        </div>
      </div>
      <label class="a-label" data-i18n="team.sections">Sections</label>
      <div style="display:flex;gap:16px;flex-wrap:wrap">
        {SECTION_KEYS.map((k) => (
          <label style="display:flex;gap:6px;align-items:center;font-weight:500">
            <input type="checkbox" name="sections" value={k} /> <span data-i18n={`nav.${k}`}>{k}</span>
          </label>
        ))}
      </div>
      <button type="submit" class="a-btn a-btn-primary" style="margin-top:16px" data-create-btn data-i18n="team.createLogin">Create login</button>
      <span data-create-msg style="margin-left:10px;font-size:13px"></span>
    </form>
  </div>

  <div data-staff><div class="a-empty" data-i18n="common.loading">Loading…</div></div>

  <script is:inline define:vars={{ grantable: SECTION_KEYS }}>
    window.__team = { grantable };
  </script>

  <script>
    import { getBrowserClient } from '../../../lib/supabase';
    const { grantable } = window.__team!;
    const sb = getBrowserClient();
    const toast = window.adminToast;
    const T = window.adminT;
    const staffHost = document.querySelector<HTMLElement>('[data-staff]')!;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    async function loadStaff() {
      const { data, error } = await sb.from('admin_profiles')
        .select('user_id, email, is_owner, sections, active').order('created_at', { ascending: true });
      if (error) { staffHost.innerHTML = `<div class="a-card a-empty a-error">${T('team.loadError')}</div>`; return; }
      const staff = (data ?? []).filter((p) => !p.is_owner);
      if (!staff.length) { staffHost.innerHTML = `<div class="a-card a-empty">${T('team.noStaff')}</div>`; return; }
      staffHost.innerHTML = staff.map((p) => `
        <div class="a-card" style="margin-bottom:10px" data-row="${p.user_id}">
          <div class="a-row">
            <strong>${esc(p.email)}</strong>
            <label style="font-weight:500"><input type="checkbox" data-active ${p.active ? 'checked' : ''}> ${T('common.active')}</label>
          </div>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:10px">
            ${grantable.map((k) => `<label style="display:flex;gap:6px;align-items:center;font-weight:500"><input type="checkbox" data-sec value="${k}" ${(p.sections ?? []).includes(k) ? 'checked' : ''}> ${T('nav.' + k)}</label>`).join('')}
          </div>
          <button class="a-btn a-btn-sm" data-save style="margin-top:12px" disabled>${T('common.save')}</button>
        </div>`).join('');
    }

    staffHost.addEventListener('change', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-row]');
      if (row) row.querySelector<HTMLButtonElement>('[data-save]')!.disabled = false;
    });
    staffHost.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
      if (!btn) return;
      const row = btn.closest<HTMLElement>('[data-row]')!;
      const userId = row.dataset.row!;
      const active = row.querySelector<HTMLInputElement>('[data-active]')!.checked;
      const sections = [...row.querySelectorAll<HTMLInputElement>('[data-sec]:checked')].map((i) => i.value);
      btn.disabled = true;
      const { error } = await sb.from('admin_profiles').update({ active, sections }).eq('user_id', userId);
      if (error) { toast(T('team.saveError'), 'err'); btn.disabled = false; return; }
      toast(T('toast.saved'), 'ok');
    });

    document.querySelector('[data-create]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-create-btn]')!;
      const msg = document.querySelector<HTMLElement>('[data-create-msg]')!;
      const fd = new FormData(form);
      btn.disabled = true; msg.textContent = '';
      const { error } = await sb.functions.invoke('create-worker', {
        body: {
          email: String(fd.get('email')).trim(),
          password: String(fd.get('password')),
          sections: fd.getAll('sections').map(String),
        },
      });
      btn.disabled = false;
      if (error) {
        let code = 'create_failed';
        try { code = (await (error as { context?: Response }).context?.json())?.code ?? code; } catch {}
        msg.textContent = { email_exists: T('team.emailExists'), weak_password: T('team.weakPassword') }[code] ?? T('team.createError');
        msg.style.color = 'var(--a-danger)';
        return;
      }
      msg.textContent = T('team.loginCreated'); msg.style.color = 'var(--a-ok)';
      form.reset();
      loadStaff();
    });

    window.addEventListener('admin:ready', (e) => {
      const d = (e as CustomEvent).detail as { isOwner: boolean };
      if (!d.isOwner) { location.href = '/admin/'; return; }
      loadStaff();
    });
  </script>
</AdminShell>
