---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisneylandPage from '../../components/DisneylandPage.astro';
import { t } from '../../i18n';
import { buildDisneylandSchema } from '../../utils/schema.js';

const locale = 'fr' as const;
const seo = t(locale).disneyland.seo;
const schema = buildDisneylandSchema({ locale, siteUrl: Astro.site?.toString() ?? '' });
---

<BaseLayout
  locale={locale}
  routeKey="disneyland"
  title={seo.title}
  description={seo.description}
  structuredData={schema}
>
  <DisneylandPage locale={locale} />
</BaseLayout>
