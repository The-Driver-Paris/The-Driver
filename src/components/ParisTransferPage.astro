---
import { pathForRoute } from '../i18n';
import { parisTransferData } from '../utils/parisPages.js';
import Icon from './Icon.astro';
import PageCloseCTA from './PageCloseCTA.astro';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const { d, routeItems, faqItems } = parisTransferData(locale);

const homePath = pathForRoute('home', locale);
function bookHref(from: string, to: string): string {
  return `${homePath}?pickup=${encodeURIComponent(from)}&dropoff=${encodeURIComponent(to)}#hero`;
}
const homeBooking = `${homePath}#booking-form`;
const waHref = 'https://wa.me/33634301292';
const disneylandHref = pathForRoute('disneyland', locale);
const chauffeurHref = pathForRoute('parisChauffeur', locale);

const WA_SVG =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---

{/* 1 · Hero */}
<section class="pt-hero" aria-labelledby="pt-hero-h">
  <div class="pt-hero-photo" aria-hidden="true">
    <picture>
      <source srcset="/images/routes/aeroport.avif" type="image/avif" />
      <source srcset="/images/routes/aeroport.webp" type="image/webp" />
      <img src="/images/routes/aeroport.jpg" alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="pt-hero-veil"></div>
  </div>
  <div class="pt-hero-inner page-x mx-auto max-w-[940px] text-center">
    <p class="pt-eyebrow" data-reveal>{d.hero.eyebrow}</p>
    <h1 id="pt-hero-h" class="pt-hero-title text-balance" data-reveal data-reveal-delay="1">{d.hero.title}</h1>
    <p class="pt-hero-sub" data-reveal data-reveal-delay="2">{d.hero.sub}</p>
    <ul class="pt-pills" data-reveal data-reveal-delay="3">
      {d.hero.pills.map((p: string) => <li class="pt-pill">{p}</li>)}
    </ul>
    <div class="pt-actions" data-reveal data-reveal-delay="4">
      <a href={bookHref('CDG', 'Paris')} class="pt-btn pt-btn-primary" data-press>
        <span>{d.hero.primaryCta}</span>
        <Icon name="arrow-right" size={16} strokeWidth={2} />
      </a>
      <a href={waHref} target="_blank" rel="noopener noreferrer" class="pt-btn pt-btn-ghost" data-press>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="pt-wa"><path d={WA_SVG} /></svg>
        <span>{d.hero.secondaryCta}</span>
      </a>
    </div>
  </div>
</section>

{/* 2 · Routes */}
<section class="pt-routes section-y has-grain" aria-labelledby="pt-routes-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="pt-head" data-reveal>
      <p class="meta-label mb-3">{d.routes.eyebrow}</p>
      <h2 id="pt-routes-h" class="h2 text-balance">{d.routes.heading}</h2>
      <p class="body-lg mt-3 pt-head-sub">{d.routes.sub}</p>
    </div>
    <ul class="pt-route-grid" data-reveal data-reveal-delay="1">
      {routeItems.map((r: any) => (
        <li class="pt-route-card">
          <div class="pt-route-body">
            <h3 class="pt-route-name">{r.name}</h3>
            <p class="pt-route-blurb">{r.blurb}</p>
            <dl class="pt-route-meta">
              <div><dt>{d.routes.timeLabel}</dt><dd>{r.time}</dd></div>
              <div><dt>{d.routes.distanceLabel}</dt><dd>{r.distance}</dd></div>
            </dl>
          </div>
          <div class="pt-route-foot">
            <div class="pt-route-prices">
              {typeof r.carFrom === 'number' && (
                <p class="pt-route-price"><span class="pt-route-price-label">{d.routes.fromLabel}</span><span class="pt-route-price-value">€{r.carFrom}</span></p>
              )}
              {typeof r.vanFrom === 'number' && (
                <p class="pt-route-price pt-route-price-alt"><span class="pt-route-price-label">{d.routes.vanLabel}</span><span class="pt-route-price-value">€{r.vanFrom}</span></p>
              )}
            </div>
            <a href={bookHref(r.from, r.to)} class="pt-route-cta" data-press>
              <span>{d.routes.bookCta}</span>
              <Icon name="arrow-right" size={15} strokeWidth={2} />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* 3 · Always included */}
<section class="pt-inc section-y" aria-labelledby="pt-inc-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="pt-head" data-reveal>
      <p class="meta-label mb-3">{d.included.eyebrow}</p>
      <h2 id="pt-inc-h" class="h2 text-balance">{d.included.heading}</h2>
      <p class="body-lg mt-3 pt-head-sub">{d.included.sub}</p>
    </div>
    <ul class="pt-inc-grid" data-reveal data-reveal-delay="1">
      {d.included.items.map((item: any) => (
        <li class="pt-inc-card">
          <span class="pt-inc-icon" aria-hidden="true"><Icon name={item.icon} size={22} strokeWidth={1.6} /></span>
          <h3 class="pt-inc-title">{item.title}</h3>
          <p class="pt-inc-body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* 4 · Vehicles */}
<section class="pt-veh section-y has-grain" aria-labelledby="pt-veh-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="pt-head" data-reveal>
      <p class="meta-label mb-3">{d.vehicles.eyebrow}</p>
      <h2 id="pt-veh-h" class="h2 text-balance">{d.vehicles.heading}</h2>
      <p class="body-lg mt-3 pt-head-sub">{d.vehicles.sub}</p>
    </div>
    <div class="pt-veh-grid" data-reveal data-reveal-delay="1">
      {[
        { img: 'tesla', data: d.vehicles.car },
        { img: 'vito', data: d.vehicles.van },
      ].map((v: any) => (
        <article class="pt-veh-card">
          <div class="pt-veh-media">
            <picture>
              <source srcset={`/images/fleet/${v.img}.avif`} type="image/avif" />
              <source srcset={`/images/fleet/${v.img}.webp`} type="image/webp" />
              <img src={`/images/fleet/${v.img}.jpg`} alt={v.data.model} width="640" height="420" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="pt-veh-info">
            <p class="pt-veh-label">{v.data.label}</p>
            <h3 class="pt-veh-model">{v.data.model}</h3>
            <p class="pt-veh-cap">{v.data.capacity}</p>
            <p class="pt-veh-desc">{v.data.body}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="pt-veh-note" data-reveal>{d.vehicles.note}</p>
  </div>
</section>

{/* 5 · How it works */}
<section class="pt-how section-y" aria-labelledby="pt-how-h">
  <div class="page-x mx-auto max-w-[1000px]">
    <div class="pt-head" data-reveal>
      <p class="meta-label mb-3">{d.how.eyebrow}</p>
      <h2 id="pt-how-h" class="h2 text-balance">{d.how.heading}</h2>
    </div>
    <ol class="pt-how-grid" data-reveal data-reveal-delay="1">
      {d.how.steps.map((step: any, i: number) => (
        <li class="pt-how-step">
          <span class="pt-how-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="pt-how-title">{step.title}</h3>
          <p class="pt-how-body">{step.body}</p>
        </li>
      ))}
    </ol>
    <p class="pt-crosslink" data-reveal>
      <a href={disneylandHref}>{d.crosslinks.disneyland}</a>
      <span aria-hidden="true"> · </span>
      <a href={chauffeurHref}>{d.crosslinks.chauffeur}</a>
    </p>
  </div>
</section>

{/* 6 · FAQ */}
<section class="pt-faq" aria-labelledby="pt-faq-h">
  <div class="pt-faq-accent" aria-hidden="true"></div>
  <div class="page-x mx-auto max-w-[800px] section-y pt-faq-inner">
    <header class="pt-head pt-head-invert" data-reveal>
      <p class="meta-label mb-3">{d.faq.eyebrow}</p>
      <h2 id="pt-faq-h" class="h2 text-balance">{d.faq.heading}</h2>
    </header>
    <ul class="pt-faq-list mt-10 md:mt-14">
      {faqItems.map((item: any, i: number) => (
        <li class="pt-faq-row" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <details class="pt-faq-item">
            <summary class="pt-faq-summary">
              <span class="pt-faq-q">{item.q}</span>
              <span class="pt-faq-toggle" aria-hidden="true"><Icon name="chevron-down" size={18} strokeWidth={2} /></span>
            </summary>
            <div class="pt-faq-a"><p>{item.a}</p></div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* 7 · Final CTA */}
<PageCloseCTA
  heading={d.finalCta.heading}
  sub={d.finalCta.sub}
  primaryLabel={d.finalCta.primary}
  primaryFallbackHref={homeBooking}
  secondaryLabel={d.finalCta.whatsapp}
  secondaryHref={waHref}
  footnote={d.finalCta.footnote}
/>

<style>
  .pt-head { max-width: 720px; }
  .pt-head-sub { color: color-mix(in oklab, var(--color-ink) 74%, transparent); max-width: 62ch; }
  .pt-head-invert .h2 { color: var(--color-cream); }
  .pt-eyebrow {
    font-family: var(--font-sans); font-size: 12px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 16px;
  }

  /* Hero */
  .pt-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--color-cream); color: var(--color-ink); padding: 64px 0 72px; }
  @media (min-width: 768px) { .pt-hero { padding: 96px 0 104px; } }
  .pt-hero-photo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .pt-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 42%; filter: saturate(0.9); }
  .pt-hero-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 50% 38%, rgba(255,250,242,0.18) 0%, rgba(255,250,242,0.80) 62%, var(--color-cream) 100%),
      linear-gradient(to bottom, rgba(255,250,242,0.28), rgba(255,250,242,0.94));
  }
  .pt-hero-inner { position: relative; z-index: 1; }
  .pt-hero-title {
    margin: 0 auto; font-family: var(--font-display); font-weight: 500; font-size: 40px;
    line-height: 1.05; letter-spacing: -0.02em; color: var(--color-ink); max-width: 20ch;
  }
  @media (min-width: 768px) { .pt-hero-title { font-size: 56px; } }
  @media (min-width: 1024px) { .pt-hero-title { font-size: 64px; } }
  .pt-hero-sub { margin: 20px auto 0; max-width: 60ch; font-size: 16px; line-height: 1.6; color: color-mix(in oklab, var(--color-ink) 78%, transparent); }
  @media (min-width: 768px) { .pt-hero-sub { font-size: 17px; margin-top: 24px; } }
  .pt-pills { list-style: none; padding: 0; margin: 28px auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .pt-pill { padding: 6px 14px; border-radius: 999px; background: color-mix(in oklab, var(--color-paper) 90%, transparent); border: 1px solid var(--color-smoke); font-size: 12px; font-weight: 500; color: var(--color-ink); letter-spacing: 0.02em; }
  .pt-actions { margin-top: 32px; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center; }
  @media (min-width: 640px) { .pt-actions { flex-direction: row; gap: 14px; } }

  .pt-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    height: 56px; padding: 0 26px; width: 100%; border-radius: 999px;
    font-family: var(--font-sans); font-size: 15px; font-weight: 500; text-decoration: none;
    transition: background-color 220ms var(--ease-out), color 220ms var(--ease-out), border-color 220ms var(--ease-out);
  }
  @media (min-width: 640px) { .pt-btn { width: auto; min-width: 210px; } }
  .pt-btn-primary { background: var(--color-accent); color: var(--color-paper); box-shadow: 0 18px 40px -12px color-mix(in oklab, var(--color-accent) 55%, transparent), 0 0 0 1px color-mix(in oklab, white 10%, transparent) inset; }
  .pt-btn-primary:hover { background: var(--color-accent-ink); }
  .pt-btn-ghost { background: transparent; color: var(--color-ink); border: 1.5px solid color-mix(in oklab, var(--color-ink) 26%, transparent); }
  .pt-btn-ghost:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .pt-wa { width: 18px; height: 18px; flex-shrink: 0; }

  /* Routes */
  .pt-routes { background: var(--color-cream); }
  .pt-route-grid { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 768px) { .pt-route-grid { grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 48px; } }
  .pt-route-card { display: flex; flex-direction: column; background: var(--color-paper); border: 1px solid var(--color-smoke); border-radius: 16px; padding: 24px; transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out); }
  .pt-route-card:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke)); box-shadow: 0 14px 30px -18px rgba(20,20,20,0.18); }
  .pt-route-body { flex: 1; }
  .pt-route-name { margin: 0 0 8px; font-family: var(--font-display); font-weight: 500; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; color: var(--color-ink); }
  .pt-route-blurb { margin: 0; font-size: 14px; line-height: 1.55; color: color-mix(in oklab, var(--color-ink) 74%, transparent); }
  .pt-route-meta { display: flex; gap: 28px; margin: 16px 0 0; }
  .pt-route-meta dt { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-graphite); margin-bottom: 2px; }
  .pt-route-meta dd { margin: 0; font-size: 14px; font-weight: 500; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .pt-route-foot { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--color-smoke); display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .pt-route-prices { display: flex; flex-direction: column; gap: 4px; }
  .pt-route-price { margin: 0; display: flex; flex-direction: column; }
  .pt-route-price-label { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-graphite); }
  .pt-route-price-value { font-family: var(--font-display); font-weight: 500; font-size: 22px; line-height: 1.1; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .pt-route-price-alt .pt-route-price-value { font-size: 16px; color: color-mix(in oklab, var(--color-ink) 70%, transparent); }
  .pt-route-cta { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; background: color-mix(in oklab, var(--color-accent) 12%, transparent); color: var(--color-accent-ink); font-family: var(--font-sans); font-size: 13.5px; font-weight: 600; text-decoration: none; transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out); }
  .pt-route-cta:hover { background: var(--color-accent); color: var(--color-paper); }

  /* Included */
  .pt-inc { background: var(--color-paper); }
  .pt-inc-grid { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 768px) { .pt-inc-grid { grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 48px; } }
  .pt-inc-card { background: var(--color-cream); border: 1px solid var(--color-smoke); border-radius: 14px; padding: 24px; transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out); }
  .pt-inc-card:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke)); box-shadow: 0 14px 30px -18px rgba(20,20,20,0.18); }
  .pt-inc-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; background: color-mix(in oklab, var(--color-accent) 12%, transparent); color: var(--color-accent); margin-bottom: 16px; }
  .pt-inc-title { margin: 0 0 8px; font-family: var(--font-display); font-weight: 500; font-size: 18px; line-height: 1.25; letter-spacing: -0.01em; color: var(--color-ink); }
  .pt-inc-body { margin: 0; font-size: 14px; line-height: 1.55; color: color-mix(in oklab, var(--color-ink) 75%, transparent); }

  /* Vehicles */
  .pt-veh { background: var(--color-cream); }
  .pt-veh-grid { margin: 40px 0 0; display: grid; grid-template-columns: 1fr; gap: 22px; }
  @media (min-width: 768px) { .pt-veh-grid { grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 48px; } }
  .pt-veh-card { display: flex; flex-direction: column; background: var(--color-paper); border: 1px solid var(--color-smoke); border-radius: 16px; overflow: hidden; transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out); }
  .pt-veh-card:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke)); box-shadow: 0 14px 30px -18px rgba(20,20,20,0.18); }
  .pt-veh-media { width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-cream); }
  .pt-veh-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 600ms var(--ease-out); }
  .pt-veh-card:hover .pt-veh-media img { transform: scale(1.03); }
  .pt-veh-info { padding: 22px 24px 24px; }
  .pt-veh-label { margin: 0 0 4px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; }
  .pt-veh-model { margin: 0 0 4px; font-family: var(--font-display); font-weight: 500; font-size: 20px; color: var(--color-ink); }
  .pt-veh-cap { margin: 0 0 12px; font-size: 13px; color: var(--color-graphite); font-variant-numeric: tabular-nums; }
  .pt-veh-desc { margin: 0; font-size: 14px; line-height: 1.55; color: color-mix(in oklab, var(--color-ink) 75%, transparent); }
  .pt-veh-note { margin: 24px 0 0; font-size: 13px; color: var(--color-graphite); text-align: center; }

  /* How */
  .pt-how { background: var(--color-paper); }
  .pt-how-grid { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 640px) { .pt-how-grid { grid-template-columns: 1fr 1fr; gap: 20px; } }
  @media (min-width: 1024px) { .pt-how-grid { grid-template-columns: repeat(4, 1fr); } }
  .pt-how-step { background: var(--color-cream); border: 1px solid var(--color-smoke); border-radius: 14px; padding: 22px; }
  .pt-how-num { display: block; font-family: var(--font-display); font-weight: 500; font-size: 13px; letter-spacing: 0.04em; color: var(--color-accent); margin-bottom: 12px; }
  .pt-how-title { margin: 0 0 6px; font-family: var(--font-display); font-weight: 500; font-size: 17px; line-height: 1.25; color: var(--color-ink); }
  .pt-how-body { margin: 0; font-size: 13.5px; line-height: 1.55; color: color-mix(in oklab, var(--color-ink) 75%, transparent); }
  .pt-crosslink { margin: 32px 0 0; font-size: 13.5px; color: var(--color-graphite); }
  .pt-crosslink a { color: var(--color-accent-ink); font-weight: 600; text-decoration: none; }
  .pt-crosslink a:hover { text-decoration: underline; }

  /* FAQ */
  .pt-faq { position: relative; background: var(--color-night); color: var(--color-cream); isolation: isolate; overflow: hidden; }
  .pt-faq-accent { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(to right, transparent, color-mix(in oklab, var(--color-accent) 45%, transparent), transparent); z-index: 2; }
  .pt-faq-inner { position: relative; z-index: 1; }
  .pt-faq-list { list-style: none; padding: 0; margin: 0; }
  .pt-faq-row { border-radius: 12px; background: color-mix(in oklab, var(--color-cream) 5%, transparent); border: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent); margin-bottom: 8px; transition: background-color 240ms var(--ease-out), border-color 240ms var(--ease-out); }
