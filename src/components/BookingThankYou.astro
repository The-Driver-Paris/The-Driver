---
import { t, pathForRoute, LOCALES } from '../i18n';

// Single locale-agnostic thank-you page. The booking form redirects here
// with `?lang=fr|en|es|it`; an inline pre-paint script sets a class on
// <html> so only the matching block paints. Default is English when no
// query param is present (direct visit / refresh).

// Per-locale strings & home link, computed at build time.
const blocks = (LOCALES as readonly ('fr' | 'en' | 'es' | 'it')[]).map((loc) => {
  const f = t(loc).form;
  const homeLabel: Record<string, string> = {
    fr: 'Retour à l’accueil',
    en: 'Back to home',
    es: 'Volver al inicio',
    it: 'Torna alla home',
  };
  return {
    loc,
    eyebrow: f.eyebrow,
    title: f.success.title,
    body: f.success.body,
    prompt: f.whatsapp.prompt,
    cta: f.whatsapp.cta,
    homeLabel: homeLabel[loc],
    homeHref: pathForRoute('home', loc),
  };
});

const WA_NUMBER = '33634301292';
---

{/* Pre-paint locale switch — must run inline in <head>… but a component-
    scoped script doesn't have access to <head>, so we run it at the top
    of <body> and use `visibility:hidden` on the section until the class
    is set. The class read + add is sub-millisecond, so the flash is
    imperceptible. */}
<script is:inline>
  (function () {
    var lang = '';
    try {
      lang = new URLSearchParams(location.search).get('lang') || '';
    } catch (e) { /* noop */ }
    lang = String(lang).toLowerCase();
    if (['fr','en','es','it'].indexOf(lang) === -1) lang = 'en';
    document.documentElement.classList.add('ty-lang-' + lang);
  })();
</script>

<section class="ty section-y has-grain" aria-labelledby="ty-heading">
  <div class="page-x mx-auto max-w-[640px]">
    {blocks.map((b) => (
      <div class="ty-block" data-lang={b.loc} lang={b.loc}>
        <header class="ty-head" data-reveal>
          <p class="meta-label mb-3">{b.eyebrow}</p>
          <h1 id={b.loc === 'en' ? 'ty-heading' : undefined} class="h2 text-balance">{b.title}</h1>
        </header>

        <div
          class="ty-card mt-8"
          role="status"
          aria-live="polite"
          data-reveal
          data-reveal-delay="1"
        >
          <div class="flex items-start gap-3">
            <svg class="ty-check shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <div>
              <p class="h3 text-[color:var(--color-ink)]">{b.title}</p>
              <p class="mt-3 text-[color:var(--color-graphite)]">{b.body}</p>
            </div>
          </div>
        </div>

        <div class="ty-wa mt-8 pt-6 border-t border-[color:var(--color-smoke)] text-center" data-reveal data-reveal-delay="2">
          <p class="text-[14px] text-[color:var(--color-graphite)] mb-3">{b.prompt}</p>
          <a
            href={`https://wa.me/${WA_NUMBER}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>{b.cta}</span>
          </a>
        </div>

        <div class="mt-8 text-center" data-reveal data-reveal-delay="3">
          <a href={b.homeHref} class="ty-home-link">{b.homeLabel}</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
  /* Locale visibility — only the block matching the ?lang= param paints.
     Defined as :global so the runtime class on <html> (.ty-lang-xx) can
     reach component-scoped data-lang elements. */
  .ty-block[data-lang] { display: none; }
  html.ty-lang-fr .ty-block[data-lang="fr"],
  html.ty-lang-en .ty-block[data-lang="en"],
  html.ty-lang-es .ty-block[data-lang="es"],
  html.ty-lang-it .ty-block[data-lang="it"] { display: block; }
</style>

<style>
  .ty { background: var(--color-cream); }
  .ty-head { max-width: 520px; }
  .ty-card {
    padding: 22px 20px;
    border-radius: var(--radius-card);
    background: var(--color-paper);
    border: 1px solid color-mix(in oklab, var(--color-success) 30%, transparent);
  }
  @media (min-width: 768px) {
    .ty-card { padding: 28px 28px; }
  }
  .ty-check {
    width: 24px;
    height: 24px;
    color: var(--color-success);
  }
  .ty-home-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-graphite);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 200ms var(--ease-out);
  }
  .ty-home-link:hover { color: var(--color-ink); }
</style>
