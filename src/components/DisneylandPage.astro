---
import { pathForRoute } from '../i18n';
import { disneylandData } from '../utils/disneyland.js';
import Icon from './Icon.astro';
import PageCloseCTA from './PageCloseCTA.astro';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const { d, routeItems, faqItems } = disneylandData(locale);

// Deep-link to the home hero with the route pre-filled. BookingModal reads
// ?pickup=&dropoff= on load and only auto-opens on #booking-form, so #hero
// lands the visitor on the picker without popping the modal (same pattern
// as Footer.astro's SEO links).
const homePath = pathForRoute('home', locale);
function bookHref(from: string, to: string): string {
  return `${homePath}?pickup=${encodeURIComponent(from)}&dropoff=${encodeURIComponent(to)}#hero`;
}
const homeBooking = `${homePath}#booking-form`;
const waHref = 'https://wa.me/33634301292';
---

{/* ───────────────────────── 1 · Hero ───────────────────────── */}
<section class="dl-hero" aria-labelledby="dl-hero-h">
  <div class="dl-hero-photo" aria-hidden="true">
    <picture>
      <source srcset="/images/routes/disneyland.avif" type="image/avif" />
      <source srcset="/images/routes/disneyland.webp" type="image/webp" />
      <img src="/images/routes/disneyland.jpg" alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="dl-hero-veil"></div>
  </div>

  <div class="dl-hero-inner page-x mx-auto max-w-[940px] text-center">
    <p class="dl-hero-eyebrow" data-reveal>{d.hero.eyebrow}</p>
    <h1 id="dl-hero-h" class="dl-hero-title text-balance" data-reveal data-reveal-delay="1">{d.hero.title}</h1>
    <p class="dl-hero-sub" data-reveal data-reveal-delay="2">{d.hero.sub}</p>

    <ul class="dl-hero-pills" data-reveal data-reveal-delay="3">
      {d.hero.pills.map((pill: string) => <li class="dl-hero-pill">{pill}</li>)}
    </ul>

    <div class="dl-hero-actions" data-reveal data-reveal-delay="4">
      <a href={bookHref('CDG', 'Disneyland')} class="dl-btn dl-btn-primary" data-press>
        <span>{d.hero.primaryCta}</span>
        <Icon name="arrow-right" size={16} strokeWidth={2} />
      </a>
      <a href={waHref} target="_blank" rel="noopener noreferrer" class="dl-btn dl-btn-ghost" data-press>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="dl-wa-icon">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>{d.hero.secondaryCta}</span>
      </a>
    </div>
  </div>
</section>

{/* ─────────────────────── 2 · Routes ─────────────────────── */}
<section class="dl-routes section-y has-grain" aria-labelledby="dl-routes-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="dl-head" data-reveal>
      <p class="meta-label mb-3">{d.routes.eyebrow}</p>
      <h2 id="dl-routes-h" class="h2 text-balance">{d.routes.heading}</h2>
      <p class="body-lg mt-3 dl-head-sub">{d.routes.sub}</p>
    </div>

    <ul class="dl-route-grid" data-reveal data-reveal-delay="1">
      {routeItems.map((r: any) => (
        <li class="dl-route-card">
          <div class="dl-route-body">
            <h3 class="dl-route-name">{r.name}</h3>
            <p class="dl-route-blurb">{r.blurb}</p>
            <dl class="dl-route-meta">
              <div>
                <dt>{d.routes.timeLabel}</dt>
                <dd>{r.time}</dd>
              </div>
              <div>
                <dt>{d.routes.distanceLabel}</dt>
                <dd>{r.distance}</dd>
              </div>
            </dl>
          </div>
          <div class="dl-route-foot">
            <div class="dl-route-prices">
              {typeof r.carFrom === 'number' && (
                <p class="dl-route-price">
                  <span class="dl-route-price-label">{d.routes.fromLabel}</span>
                  <span class="dl-route-price-value">€{r.carFrom}</span>
                </p>
              )}
              {typeof r.vanFrom === 'number' && (
                <p class="dl-route-price dl-route-price-alt">
                  <span class="dl-route-price-label">{d.routes.vanLabel}</span>
                  <span class="dl-route-price-value">€{r.vanFrom}</span>
                </p>
              )}
            </div>
            <a href={bookHref(r.from, r.to)} class="dl-route-cta" data-press>
              <span>{d.routes.bookCta}</span>
              <Icon name="arrow-right" size={15} strokeWidth={2} />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ─────────────────────── 3 · Families ─────────────────────── */}
<section class="dl-fam section-y" aria-labelledby="dl-fam-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="dl-head" data-reveal>
      <p class="meta-label mb-3">{d.families.eyebrow}</p>
      <h2 id="dl-fam-h" class="h2 text-balance">{d.families.heading}</h2>
      <p class="body-lg mt-3 dl-head-sub">{d.families.sub}</p>
    </div>

    <ul class="dl-fam-grid" data-reveal data-reveal-delay="1">
      {d.families.items.map((item: any) => (
        <li class="dl-fam-card">
          <span class="dl-fam-icon" aria-hidden="true">
            <Icon name={item.icon} size={22} strokeWidth={1.6} />
          </span>
          <h3 class="dl-fam-title">{item.title}</h3>
          <p class="dl-fam-body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ─────────────────────── 4 · Vehicles ─────────────────────── */}
<section class="dl-veh section-y has-grain" aria-labelledby="dl-veh-h">
  <div class="page-x mx-auto max-w-[1100px]">
    <div class="dl-head" data-reveal>
      <p class="meta-label mb-3">{d.vehicles.eyebrow}</p>
      <h2 id="dl-veh-h" class="h2 text-balance">{d.vehicles.heading}</h2>
      <p class="body-lg mt-3 dl-head-sub">{d.vehicles.sub}</p>
    </div>

    <div class="dl-veh-grid" data-reveal data-reveal-delay="1">
      {[
        { key: 'car', img: 'tesla', data: d.vehicles.car },
        { key: 'van', img: 'vito', data: d.vehicles.van },
      ].map((v: any) => (
        <article class="dl-veh-card">
          <div class="dl-veh-media">
            <picture>
              <source srcset={`/images/fleet/${v.img}.avif`} type="image/avif" />
              <source srcset={`/images/fleet/${v.img}.webp`} type="image/webp" />
              <img src={`/images/fleet/${v.img}.jpg`} alt={v.data.model} width="640" height="420" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="dl-veh-info">
            <p class="dl-veh-label">{v.data.label}</p>
            <h3 class="dl-veh-model">{v.data.model}</h3>
            <p class="dl-veh-cap">{v.data.capacity}</p>
            <p class="dl-veh-desc">{v.data.body}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="dl-veh-note" data-reveal>{d.vehicles.note}</p>
  </div>
</section>

{/* ─────────────────────── 5 · How it works ─────────────────────── */}
<section class="dl-how section-y" aria-labelledby="dl-how-h">
  <div class="page-x mx-auto max-w-[1000px]">
    <div class="dl-head" data-reveal>
      <p class="meta-label mb-3">{d.how.eyebrow}</p>
      <h2 id="dl-how-h" class="h2 text-balance">{d.how.heading}</h2>
    </div>

    <ol class="dl-how-grid" data-reveal data-reveal-delay="1">
      {d.how.steps.map((step: any, i: number) => (
        <li class="dl-how-step">
          <span class="dl-how-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="dl-how-title">{step.title}</h3>
          <p class="dl-how-body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ─────────────────────── 6 · FAQ ─────────────────────── */}
<section class="dl-faq" aria-labelledby="dl-faq-h">
  <div class="dl-faq-accent" aria-hidden="true"></div>
  <div class="page-x mx-auto max-w-[800px] section-y dl-faq-inner">
    <header class="dl-head dl-head-invert" data-reveal>
      <p class="meta-label mb-3">{d.faq.eyebrow}</p>
      <h2 id="dl-faq-h" class="h2 text-balance">{d.faq.heading}</h2>
    </header>

    <ul class="dl-faq-list mt-10 md:mt-14">
      {faqItems.map((item: any, i: number) => (
        <li class="dl-faq-row" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <details class="dl-faq-item">
            <summary class="dl-faq-summary">
              <span class="dl-faq-q">{item.q}</span>
              <span class="dl-faq-toggle" aria-hidden="true">
                <Icon name="chevron-down" size={18} strokeWidth={2} />
              </span>
            </summary>
            <div class="dl-faq-a"><p>{item.a}</p></div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ─────────────────────── 7 · Final CTA ─────────────────────── */}
<PageCloseCTA
  heading={d.finalCta.heading}
  sub={d.finalCta.sub}
  primaryLabel={d.finalCta.primary}
  primaryFallbackHref={homeBooking}
  secondaryLabel={d.finalCta.whatsapp}
  secondaryHref={waHref}
  footnote={d.finalCta.footnote}
/>

<style>
  /* ---------- shared section head ---------- */
  .dl-head { max-width: 720px; }
  .dl-head-sub { color: color-mix(in oklab, var(--color-ink) 74%, transparent); max-width: 62ch; }
  .dl-head-invert .h2 { color: var(--color-cream); }

  /* ================== 1 · HERO ================== */
  .dl-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-cream);
    color: var(--color-ink);
    padding-top: 64px;
    padding-bottom: 72px;
  }
  @media (min-width: 768px) {
    .dl-hero { padding-top: 96px; padding-bottom: 104px; }
  }
  .dl-hero-photo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .dl-hero-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.9);
  }
  .dl-hero-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 50% 38%, rgba(255, 250, 242, 0.18) 0%, rgba(255, 250, 242, 0.80) 62%, var(--color-cream) 100%),
      linear-gradient(to bottom, rgba(255, 250, 242, 0.28), rgba(255, 250, 242, 0.94));
  }
  .dl-hero-inner { position: relative; z-index: 1; }
  .dl-hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 16px;
  }
  .dl-hero-title {
    margin: 0 auto;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 20ch;
  }
  @media (min-width: 768px) { .dl-hero-title { font-size: 56px; } }
  @media (min-width: 1024px) { .dl-hero-title { font-size: 64px; } }
  .dl-hero-sub {
    margin: 20px auto 0;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-ink) 78%, transparent);
  }
  @media (min-width: 768px) { .dl-hero-sub { font-size: 17px; margin-top: 24px; } }
  .dl-hero-pills {
    list-style: none;
    padding: 0;
    margin: 28px auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .dl-hero-pill {
    padding: 6px 14px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-paper) 90%, transparent);
    border: 1px solid var(--color-smoke);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }
  .dl-hero-actions {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 640px) { .dl-hero-actions { flex-direction: row; gap: 14px; } }

  /* ---------- buttons ---------- */
  .dl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    padding: 0 26px;
    width: 100%;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 220ms var(--ease-out), color 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 260ms var(--ease-out);
  }
  @media (min-width: 640px) { .dl-btn { width: auto; min-width: 210px; } }
  .dl-btn-primary {
    background: var(--color-accent);
    color: var(--color-paper);
    box-shadow:
      0 18px 40px -12px color-mix(in oklab, var(--color-accent) 55%, transparent),
      0 0 0 1px color-mix(in oklab, white 10%, transparent) inset;
  }
  .dl-btn-primary:hover { background: var(--color-accent-ink); }
  .dl-btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1.5px solid color-mix(in oklab, var(--color-ink) 26%, transparent);
  }
  .dl-btn-ghost:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .dl-wa-icon { width: 18px; height: 18px; flex-shrink: 0; }

  /* ================== 2 · ROUTES ================== */
  .dl-routes { background: var(--color-cream); }
  .dl-route-grid {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 768px) {
    .dl-route-grid { grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 48px; }
  }
  .dl-route-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-smoke);
    border-radius: 16px;
    padding: 24px;
    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .dl-route-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke));
    box-shadow: 0 14px 30px -18px rgba(20, 20, 20, 0.18);
  }
  .dl-route-body { flex: 1; }
  .dl-route-name {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .dl-route-blurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-ink) 74%, transparent);
  }
  .dl-route-meta {
    display: flex;
    gap: 28px;
    margin: 16px 0 0;
  }
  .dl-route-meta dt {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-graphite);
    margin-bottom: 2px;
  }
  .dl-route-meta dd {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .dl-route-foot {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--color-smoke);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .dl-route-prices { display: flex; flex-direction: column; gap: 4px; }
  .dl-route-price { margin: 0; display: flex; flex-direction: column; }
  .dl-route-price-label {
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-graphite);
  }
  .dl-route-price-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .dl-route-price-alt .dl-route-price-value { font-size: 16px; color: color-mix(in oklab, var(--color-ink) 70%, transparent); }
  .dl-route-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
    color: var(--color-accent-ink);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .dl-route-cta:hover { background: var(--color-accent); color: var(--color-paper); }

  /* ================== 3 · FAMILIES ================== */
  .dl-fam { background: var(--color-paper); }
  .dl-fam-grid {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .dl-fam-grid { grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 48px; }
  }
  .dl-fam-card {
    background: var(--color-cream);
    border: 1px solid var(--color-smoke);
    border-radius: 14px;
    padding: 24px;
    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .dl-fam-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke));
    box-shadow: 0 14px 30px -18px rgba(20, 20, 20, 0.18);
  }
  .dl-fam-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    margin-bottom: 16px;
  }
  .dl-fam-title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .dl-fam-body {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-ink) 75%, transparent);
  }

  /* ================== 4 · VEHICLES ================== */
  .dl-veh { background: var(--color-cream); }
  .dl-veh-grid {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  @media (min-width: 768px) {
    .dl-veh-grid { grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 48px; }
  }
  .dl-veh-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-smoke);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .dl-veh-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-smoke));
    box-shadow: 0 14px 30px -18px rgba(20, 20, 20, 0.18);
  }
  .dl-veh-media { width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-cream); }
  .dl-veh-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 600ms var(--ease-out); }
  .dl-veh-card:hover .dl-veh-media img { transform: scale(1.03); }
  .dl-veh-info { padding: 22px 24px 24px; }
  .dl-veh-label {
    margin: 0 0 4px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .dl-veh-model {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 500;
